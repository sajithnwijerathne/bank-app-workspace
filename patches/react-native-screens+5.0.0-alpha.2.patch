+                for (fragmentWrapper in screenFragmentsBeneathTop) {
+                    val accessibilityMode =
+                        if (shouldDisableFocusability) IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS else IMPORTANT_FOR_ACCESSIBILITY_AUTO
