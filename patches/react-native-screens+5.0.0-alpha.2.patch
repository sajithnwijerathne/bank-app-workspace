+    enum class ActivityMode {
+        DETACHED,
+        ATTACHED,
+    }
+
+    private val containerItemSupport = ContainerItemSupport()
+
+    internal var isPreventNativeDismissEnabled: Boolean by Delegates.observable(false) { _, oldValue, newValue ->
+        if (oldValue != newValue) {
