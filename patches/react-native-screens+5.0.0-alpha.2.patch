+    override fun getEventData(): WritableMap? =
+        Arguments.createMap().apply {
+            putDouble("headerHeight", headerHeightInDp)
+        }
+
+    companion object {
+        const val EVENT_NAME = "topHeaderHeightChange"
+    }
+}
