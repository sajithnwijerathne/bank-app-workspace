+        for (i in 0 until toolbar.childCount) {
+            val child = toolbar.getChildAt(i)
+            // Assumes only StackHeaderSubview children exist in Collapsing toolbar besides
+            // the CTL dummy view.
+            if (child !is StackHeaderSubview) {
