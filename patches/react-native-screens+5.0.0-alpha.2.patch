+    // region Menu prop parsing
+
+    internal fun parseMenu(
+        context: Context,
+        value: Dynamic,
+    ): Pair<StackHeaderToolbarMenuConfig, Map<String, StackHeaderToolbarMenuItemIconSource>> {
