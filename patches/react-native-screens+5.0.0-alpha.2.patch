+internal fun interface StackHeaderToolbarMenuIconResolver {
+    fun resolve(
+        iconSource: StackHeaderToolbarMenuItemIconSource,
+        onResolved: (icon: StackHeaderToolbarFieldUpdate<Drawable>) -> Unit,
+    )
+}
