+     */
+    internal fun applyLiftOnScroll(
+        appBar: StackHeaderAppBarLayout,
+        enabled: Boolean,
+        targetScrollView: ViewGroup?,
+    ) {
+        if (appBar !is StackHeaderAppBarLayout.Small) return
+
+        appBar.isLiftOnScroll = enabled
