+        when (screen.sheetDetents.count) {
+            1 ->
+                behavior.apply {
+                    state = BottomSheetBehavior.STATE_EXPANDED
+                    skipCollapsed = true
+                    isFitToContents = true
+                    maxHeight = screen.sheetDetents.maxAllowedHeight(containerHeight)
+                }
